# build_stamp.cmake: writes build_stamp_gen.h, the build's identity for the log's first lines (4.3 part 3, the logging
# list's item 1; snatcherLeo approved the list 2026-11-22: "our logger should be able to tell us EVERYTHING we need to know
# about that user's app before it crashed").
#
# Why: a log or a report has to say which build it came from: the commit, whether the tree had uncommitted changes,
# the branch, when it was built, and whether it's the main checkout's build (the one snatcherLeo runs from the Desktop
# shortcut) or a worktree's test build. The same line shape as OrrePort's stamp (port/tools/firstlink.py,
# write_build_stamp), so one reader handles both programs' logs.
#
# Run at every build by a custom target (CMakeLists.txt): cmake -DSRC=<repo> -DOUT=<file> -DPROGRAM=<name> -P this.
# The header is rewritten only when its text changes, but the time is in it, so the one file including it (diag/
# build_stamp.c) recompiles on each build: a moment, and the exe is relinked anyway.
# Plain CMake and git: the same on Windows, Linux and macOS.

find_package(Git QUIET)
set(commit "unknown")
set(branch "?")
set(dirty "")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=9 HEAD WORKING_DIRECTORY ${SRC}
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r1)
  if(NOT r1 EQUAL 0)
    set(commit "unknown")
  endif()
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD WORKING_DIRECTORY ${SRC}
                  OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no WORKING_DIRECTORY ${SRC}
                  OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT changes STREQUAL "")
    set(dirty " +changes")
  endif()
endif()
string(TIMESTAMP when "%Y-%m-%d %H:%M")
# the main checkout (its folder is pkmn_colosseum) builds what snatcherLeo runs; any other folder is a worktree's test build
get_filename_component(src_abs ${SRC} ABSOLUTE)  # (SRC arrives as "<repo>/studio/..")
get_filename_component(folder ${src_abs} NAME)
if(folder STREQUAL "pkmn_colosseum")
  set(label "MAIN BUILD")
else()
  set(label "TEST BUILD (${folder})")
endif()
set(stamp "${PROGRAM} ${label} - ${commit}${dirty} (${branch}) built ${when}")
set(text "/* generated by studio/diag/build_stamp.cmake at build time; not in version control */\n#define DIAG_BUILD_STAMP \"${stamp}\"\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE ${OUT} "${text}")
endif()
