// studio.rc: the Windows resources of OrrePort Studio (Windows only; Qt and AppKit builds carry these facts in their
// own bundle files). The manifest turns on version 6 of the standard controls (the search box's hint text and dark
// scroll bars need it), per-monitor DPI v2 and UTF-8 as the process code page. The window's icons are set at run time
// from the hub's SVGs (theme.cpp).
#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "studio.manifest"

// The exe's own icon (2026-11-21, the project's request): Explorer, the Start menu and shortcuts read an exe's icon from its
// resources (the ICON with the lowest id), so without this bin\orrestudio.exe showed Windows' generic icon. The file
// is OrrePort's O in sage, the same art Studio's dark-mode window draws (theme.cpp's rust-to-sage recolour equals the
// sage SVGs, verified by Main), generated by tools/local/port/make_launcher_icon.py and shared with the "OrrePort
// Studio.exe" launcher (port/launcher/orre_launcher.rc). snatcherLeo, 2026-11-21: Studio uses the sage O as in-app, the hub
// ("OrrePort.exe") the dark red one (orreport-rust.ico). Windows-only: an .ico in a resource script. Linux would install an icon file
// with a .desktop entry, macOS an .icns in the app bundle (likely; neither exists yet).
1 ICON "../../port/launcher/orreport-sage.ico"
