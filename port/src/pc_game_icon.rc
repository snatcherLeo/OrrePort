// pc_game_icon.rc: the icon and version details of the game's own exe, bin\orrecolo.exe (4.1, 2026-11-21).
//
// Why: Explorer, the Start menu, shortcuts and a taskbar pin of the running game take an exe's icon from its resources
// (the first ICON resource, lowest id). The O that pc_window_icon.cpp draws at run time only reaches the open window,
// so without this file bin\orrecolo.exe showed Windows' blank program icon in the play folder. It carries the rust O,
// port/launcher/orreport-rust.ico, the same file as the OrrePort.exe launcher (snatcherLeo, 2026-11-21: "the OrrePort hub
// needs to use the dark red one that we have"); the .ico is generated by tools/local/port/make_launcher_icon.py.
// SDL3 also uses an exe's first icon as its window class's default icon until pc_window_icon.cpp sets the chosen
// colour (likely, from SDL's Windows code), so the window shows the rust O for the moment before that.
//
// No manifest here on purpose: the exe keeps the one MinGW's gcc links into every program (default-manifest.o:
// asInvoker and the supported Windows versions; verified in older builds too). A manifest of our own changes how
// Windows treats the game (DPI scaling, long paths) and needs its own check; the launchers carry one
// (port/launcher/orre_launcher.manifest).
//
// Built by port/tools/firstlink.py (step_link: windres -I port/launcher, then linked into orrecolo.exe), Windows only.
// Linux has no .rc: the icon is PNGs at the hicolor sizes (make_launcher_icon.py --png-dir) named by a .desktop file;
// macOS uses an .icns inside the .app bundle and the bundle's Info.plist for the version (likely).
#include <winver.h>

1 ICON "orreport-rust.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "OrrePort (the game)"
      VALUE "ProductName", "OrrePort"
      VALUE "FileVersion", "1.0"
      VALUE "ProductVersion", "1.0"
      VALUE "OriginalFilename", "orrecolo.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
