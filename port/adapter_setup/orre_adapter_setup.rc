// OrrePort Adapter Setup's resources (2026-11-13): the manifest (orre_adapter_setup.manifest says why) and the
// version details Windows shows in the file's Properties, so a player who finds the program can tell what it is.
// Windows only.
#include <winver.h>

1 24 "orre_adapter_setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "OrrePort Adapter Setup: sets up Nintendo's GameCube controller adapter (WinUSB driver, via libwdi)"
      VALUE "ProductName", "OrrePort"
      VALUE "FileVersion", "1.0"
      VALUE "ProductVersion", "1.0"
      VALUE "OriginalFilename", "OrrePort Adapter Setup.exe"
      VALUE "LegalCopyright", "Uses libwdi (LGPL v3, github.com/pbatard/libwdi)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
