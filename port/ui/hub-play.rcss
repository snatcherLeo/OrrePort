/* ---- end of generated ---- */

/* which layer plays which (hub.rml: #disclift > #disc (the sway's tilt) > #spin > the trail, the label, the smear) */
body.playing #disclift { animation: 2s linear 1 play-lift; }
body.playing #spin { animation: 2s linear 1 play-spin; }
body.playing #label { animation: 2s linear 1 play-sharp; }
body.playing #ghost1 { animation: 2s linear 1 play-ghost-op, 2s linear 1 play-ghost1; }
body.playing #ghost2 { animation: 2s linear 1 play-ghost-op, 2s linear 1 play-ghost2; }
body.playing #ghost3 { animation: 2s linear 1 play-ghost-op, 2s linear 1 play-ghost3; }
body.playing #smear { animation: 2s linear 1 play-smear; }
body.playing #black { animation: 2s linear 1 play-black; }
/* Appearance > Animations off (snatcherLeo, 2026-11-11; pc_hub.cpp sets body.noanim): the disc stays still, no sway, and
 * Play skips the lift, the spin, its trail and the smear; the screen still fades to black into the game */
body.noanim #discfloat, body.noanim #disc { animation: none; }
body.noanim.playing #disclift, body.noanim.playing #spin, body.noanim.playing #label,
body.noanim.playing #ghost1, body.noanim.playing #ghost2, body.noanim.playing #ghost3,
body.noanim.playing #smear { animation: none; }
/* Play as a held button (snatcherLeo, 2026-11-13, mockup 44 take 3: "yep, that's perfect"): while A / Enter / the mouse is
 * held on PLAY the disc bounces down and stays pressed in (body.hitched, pc_hub.cpp hitch; hitch-down, then held at
 * its end pose); on release it snaps up to the lift in 45 ms and the rest of the Play runs 0.11 s sooner (the snap-*
 * keyframes, body.prelifted). A mouse let go off PLAY lets the disc rise back to rest (the transition). PLAY looks
 * pressed. */
#disclift { transition: transform 0.15s cubic-out; }
body.hitched #disclift { transform: translateY(4dp) scale(0.985); animation: 0.22s linear 1 hitch-down; }
/* PLAY's pressed colour is drawn by pc_hub.cpp update_rings (its smooth face picture, the pressed shade while the body
 * is "hitched"). *Corrected 2026-11-15 (snatcherLeo: "see the green label on Play? It... changes. Why?"):* a rule here still
 * painted #play's plain background, square-cornered, behind the rounded face once the face became a picture: the
 * press showed as a square block with the rounded face on top. Removed. */
/* held, the disc only does its press: the idle sway (hub.rcss #discfloat, #disc) is frozen where it is, by the hub's
 * code (pc_hub.cpp freeze_sway: the pose at the press set inline), not switched off here, which would snap it level
 * (snatcherLeo, 2026-11-13: "If a user is pressing down teh button ... the disc will not move at all"; "No matter which way it
 * was rotated ... it would do the bounce from there") */
body.playing.prelifted #disclift { animation: 2s linear 1 snap-lift; }
body.playing.prelifted #spin { animation: 2s linear 1 snap-spin; }
body.playing.prelifted #label { animation: 2s linear 1 snap-sharp; }
body.playing.prelifted #ghost1 { animation: 2s linear 1 snap-ghost-op, 2s linear 1 snap-ghost1; }
body.playing.prelifted #ghost2 { animation: 2s linear 1 snap-ghost-op, 2s linear 1 snap-ghost2; }
body.playing.prelifted #ghost3 { animation: 2s linear 1 snap-ghost-op, 2s linear 1 snap-ghost3; }
body.playing.prelifted #smear { animation: 2s linear 1 snap-smear; }
body.playing.prelifted #black { animation: 2s linear 1 snap-black; }
body.noanim.hitched #disclift { transform: none; animation: none; }
body.noanim.playing.prelifted #disclift, body.noanim.playing.prelifted #spin, body.noanim.playing.prelifted #label,
body.noanim.playing.prelifted #ghost1, body.noanim.playing.prelifted #ghost2, body.noanim.playing.prelifted #ghost3,
body.noanim.playing.prelifted #smear { animation: none; }
