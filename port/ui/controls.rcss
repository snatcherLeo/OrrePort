/* The controller setup screen (port/src/pc_controls_ui.cpp; mockups 17 / 18, then 20-22 after snatcherLeo's hand check:
 * build-pc/mockups/ingame/c20). Fonts: Inter, Saira (ui/fonts). The labels', rings' and lit lines' places are in
 * controls/gcpad-layout.rcss (generated by tools/local/brand/gcpad_stage.py). The whole screen is about 1,340 x 800 dp
 * and scaled to fit the window. */
body { width: 100%; height: 100%; font-family: "Inter"; font-size: 14dp; }

/* ---- the top bar ---- */
#top { position: absolute; left: 0dp; right: 0dp; top: 0dp; height: 64dp; border-bottom-width: 1dp; }
#back { position: absolute; left: 24dp; top: 16dp; width: 32dp; height: 32dp; line-height: 30dp; text-align: center;
        border-radius: 9dp; border-width: 1dp; font-size: 18dp; cursor: pointer; }
#title { position: absolute; left: 68dp; top: 14dp; font-family: "Saira"; font-size: 22dp; font-weight: bold; }
/* inside the title now, right after its words (*Updated 2026-11-13*, text keys; was a fixed place at 270 dp) */
#title { white-space: nowrap; }
#sub { margin-left: 30dp; font-family: "Inter"; font-size: 13dp; font-weight: normal; vertical-align: middle; }
#pick { position: absolute; right: 20dp; top: 14dp; height: 36dp; }
/* the two pickers keep one width whatever they show, and each list opens right under its own picker at the same width
 * (snatcherLeo, 2026-11-13: the list shifted with the device's name; "one unified bar and dropdown that looks polished");
 * long names are shortened with "..." in the code (pc_controls_ui.cpp short_text) */
.dsel { position: relative; display: inline-block; box-sizing: border-box; height: 34dp; line-height: 34dp;
        padding: 0dp 30dp 0dp 14dp; margin-left: 10dp; border-radius: 9dp; border-width: 1dp; font-size: 13dp;
        font-weight: bold; cursor: pointer; white-space: nowrap; overflow: hidden; }
#dev { width: 270dp; }
#prof { width: 240dp; }
.dsel .c { position: absolute; right: 12dp; top: 0dp; font-size: 10dp; }
.dsel.off { cursor: default; }

/* ---- the stage: the 960 x 640 dp frame with the picture, the rings, the lit line and the labels ---- */
#stage { position: absolute; left: 20dp; top: 84dp; width: 960dp; height: 640dp; }
#layers, #rings, #labels, #lits { position: absolute; left: 0dp; top: 0dp; width: 960dp; height: 640dp; }
/* the controller in layers (gcpad_stage.py pieces(); places in gcpad-layout.rcss): the triggers behind the body, the
 * body, each button its own picture, the D-pad with its arms' shading, then the lines. Press-in (snatcherLeo, 2026-11-12:
 * "button presses are perfect", mockups 23-40): A, B, X, Y and START sink and darken; Z gives a small dip; L and R
 * slide into the shoulders as far as they are squeezed (set per frame); the D-pad rocks toward the pressed arm. */
.piece { position: absolute; transition: transform image-color 0.05s quadratic-out; }
.piece.full, #dpadwrap { left: 0dp; top: 0dp; width: 960dp; height: 640dp; }
#dpadwrap { position: absolute; }
.piece.down { transform: scale(0.88); image-color: rgb(199, 199, 199); }
#piece-btn-Z.down { transform: translate(-0.4dp, 1dp); image-color: rgb(219, 219, 219); }
#dpadwrap.rock-UP { transform: translate(0dp, -2dp); }
#dpadwrap.rock-DOWN { transform: translate(0dp, 2dp); }
#dpadwrap.rock-LEFT { transform: translate(-2dp, 0dp); }
#dpadwrap.rock-RIGHT { transform: translate(2dp, 0dp); }
.arm.shade { display: block; background-color: rgba(26, 20, 64, 82); }
.arm.shine { display: block; background-color: rgba(255, 255, 255, 115); }
.ring { position: absolute; border-width: 4dp; border-color: transparent; }
.lit, .litdot { position: absolute; display: none; }
.lit.on, .litdot.on { display: block; }
.lab { position: absolute; width: 196dp; height: 32dp; line-height: 30dp; border-radius: 9dp; border-width: 1dp;
       padding: 0dp 10dp 0dp 6dp; font-size: 13dp; font-weight: bold; white-space: nowrap; cursor: pointer; }
.gc { display: inline-block; min-width: 20dp; height: 20dp; line-height: 20dp; padding: 0dp 4dp; margin-right: 8dp;
      margin-top: 5dp; border-radius: 10dp; font-size: 10dp; text-align: center; vertical-align: top; }
.gc.sq { border-radius: 5dp; }
.lab .on { float: right; font-weight: normal; }
.lab.listen .on { font-weight: bold; }
/* the D-pad: a heading and four rows, one per direction (snatcherLeo: "allow for the user to configure each direction") */
.grp { position: absolute; width: 196dp; border-radius: 9dp; border-width: 1dp; }
.grp .gh { display: block; height: 32dp; line-height: 30dp; padding: 0dp 10dp 0dp 6dp; font-size: 13dp;
           font-weight: bold; border-bottom-width: 1dp; }
.grp .gh .gc { margin-top: 5dp; }
.dr { display: block; height: 28dp; line-height: 28dp; padding: 0dp 10dp 0dp 14dp; font-size: 12.5dp; font-weight: bold;
      cursor: pointer; }
.dr .ar { display: inline-block; width: 20dp; }
.dr .on { float: right; font-weight: normal; }
.dr.f { border-left-width: 3dp; padding-left: 11dp; }
/* what just changed, under the controller (snatcherLeo: "we can make it green text") */
#note { position: absolute; left: 0dp; top: 600dp; width: 370dp; font-size: 13.5dp; }

/* ---- the side panel ---- */
/* 300 dp inside + 20 dp padding each side = 340 dp: the stage (20 + 960) and the panel fit 1,340 dp */
#side { position: absolute; right: 0dp; top: 64dp; bottom: 56dp; width: 300dp; padding: 14dp 20dp;
        border-left-width: 1dp; overflow-y: auto; }
/* the panel's scrollbar needs its width set: RmlUi gives an unstyled vertical scrollbar the box's whole width, which
 * squeezed the panel's columns into a strip the moment it grew taller than the window (*found 2026-11-16*: the new
 * Fast-forward row made it scroll at 1600 x 960; snatcherLeo's screenshot). All platforms (RmlUi) */
#side scrollbarvertical { width: 6dp; }
#side scrollbarvertical sliderbar { border-radius: 3dp; background-color: #3A423E; }
body.light #side scrollbarvertical sliderbar { background-color: #B8C2B6; }
.h { display: block; font-size: 10.5dp; font-weight: bold; letter-spacing: 2.4dp; margin: 10dp 0dp 8dp 0dp; }
.h.first { margin-top: 0dp; }
/* both sticks live (snatcherLeo liked Dolphin's two views; mockups 23 / 24): each a box with the GameCube's octagonal gate
 * (the C-Stick's in yellow, to scale), a dotted outline of how far the physical stick reaches (a circle until it is
 * calibrated, then the recorded shape), the dead zone, the stick (a ring) and what the game is sent (a dot) */
.gates { display: block; height: 150dp; margin: 2dp 0dp 6dp 0dp; }
.gate { display: inline-block; width: 140dp; height: 146dp; border-radius: 10dp; border-width: 1dp;
        text-align: center; cursor: pointer; vertical-align: top; box-sizing: border-box; }
#gate-0 { margin-right: 14dp; }
.gbox { position: relative; display: block; width: 112dp; height: 112dp; margin: 4dp auto 0dp auto; }
.gimg, .dzc, .rawc, .sentc, .rd, .cd { position: absolute; }
.rawc { width: 13dp; height: 13dp; border-radius: 6.5dp; border-width: 1.5dp; }
.sentc { width: 8dp; height: 8dp; border-radius: 4dp; }
.rd { width: 2.5dp; height: 2.5dp; border-radius: 1.25dp; }
.cd { width: 4dp; height: 4dp; border-radius: 2dp; }
/* Dolphin's layout (snatcherLeo, 2026-11-12, mockups 41 / 42): a column per stick, side by side; each holds its picture, the
 * Calibrate button, a row per direction, (the Control stick's) walk button and speed, the dead zone and range */
/* the columns share the panel's width by percentage, so a scrollbar (a tall panel) can't push the C-Stick column
 * under the Control Stick's (snatcherLeo, 2026-11-13: it dropped below while Quit to hub's shortcut was being chosen) */
.scol { display: inline-block; width: 48%; vertical-align: top; box-sizing: border-box; padding: 6dp 6dp 4dp 6dp;
        border-radius: 9dp; border-width: 1dp; }
#scol-0 { margin-right: 3%; }
/* *Updated 2026-11-13 (every word translatable; the pseudo language's check):* the tight labels in the stick columns are
 * cut at their own width (overflow: hidden) rather than running into the value beside them, in any language */
.sct { display: block; font-size: 11.5dp; font-weight: bold; line-height: 14dp; margin-bottom: 2dp; white-space: nowrap;
       overflow: hidden; }
.scol .gbox { margin: 0dp auto 0dp auto; cursor: pointer; }
.scol .gnum { display: none; }
.btn.cb { height: 26dp; line-height: 24dp; margin: 4dp 0dp 4dp 0dp; font-size: 11.5dp; border-radius: 7dp; white-space: nowrap; }
.drow { position: relative; display: block; height: 24dp; line-height: 24dp; font-size: 11.5dp; font-weight: bold;
        cursor: pointer; border-radius: 6dp; }
.dl { display: inline-block; width: 40dp; padding-left: 2dp; box-sizing: border-box; overflow: hidden; white-space: nowrap; }
/* a slider row's label (Speed, Dead, Range): the same 40 dp as the direction rows', cut at its end */
.cl { display: inline-block; width: 40dp; overflow: hidden; white-space: nowrap; vertical-align: top; }
.dchip { position: absolute; left: 42dp; right: 0dp; top: 2dp; height: 20dp; line-height: 18dp; border-radius: 5dp;
         border-width: 1dp; text-align: center; font-size: 11dp; font-weight: normal; white-space: nowrap; }
.crow { position: relative; display: block; height: 22dp; line-height: 22dp; padding-left: 2dp; font-size: 11.5dp;
        font-weight: bold; cursor: pointer; border-radius: 6dp; white-space: nowrap; }
.crow .v { position: absolute; right: 2dp; top: 0dp; width: 28dp; text-align: right; }
/* between the label and the number, right-aligned and cut at the label (a longer word in another language) */
.crow .lock { position: absolute; left: 44dp; right: 34dp; top: 0dp; font-size: 10.5dp; text-align: right; overflow: hidden;
              white-space: nowrap; }
.crow .track { left: 42dp; right: 36dp; width: auto; top: 9dp; }
.crow .thumb { top: -5dp; width: 13dp; height: 13dp; margin-left: -6.5dp; }
.crow .thumb .tk { width: 13dp; height: 13dp; }
.cgap { display: block; height: 46dp; }
/* rows that don't apply to this device stay in place, greyed (snatcherLeo: "Layout shouldn't change this much") */
.off { opacity: 0.38; cursor: default; }
.off .track, .off .thumb, .off .fill { cursor: default; }
.csep { display: block; height: 1dp; margin: 3dp 0dp; }
.gcap { display: block; font-size: 12dp; font-weight: bold; line-height: 14dp; }
.gnum { display: block; font-size: 12dp; line-height: 14dp; }
.gnum .x { margin: 0dp 3dp 0dp 6dp; font-weight: normal; }
.gnum b { font-weight: bold; }
/* the triggers: how far each is squeezed, where the click registers, and the click itself */
.trig { display: block; height: 28dp; line-height: 28dp; padding: 0dp 8dp; font-size: 13dp; font-weight: bold; }
.tbar { position: relative; display: inline-block; width: 170dp; height: 8dp; margin: 0dp 10dp 0dp 10dp;
        border-radius: 4dp; vertical-align: middle; }
.tfill { position: absolute; left: 0dp; top: 0dp; height: 8dp; border-radius: 4dp; }
.tclick { position: absolute; top: -4dp; width: 2dp; height: 16dp; margin-left: -1dp; }
.tpc { display: inline-block; width: 40dp; text-align: right; }
.tdig { display: inline-block; width: 13dp; height: 13dp; margin-left: 8dp; border-radius: 7dp; border-width: 1.5dp;
        vertical-align: middle; }
/* the press feedback on the picture (snatcherLeo: "a small animation when you "click" the button"): a pulse that fades, a
 * "pushed in" cover while held, the D-pad's pressed arm, a loose dot on each stick cap; places in gcpad-layout.rcss */
/* (the first round's pulse ring and "pushed in" cover gave way to the press-in pieces above) */
.arm, .follow { position: absolute; display: none; }
.follow.on { display: block; }
.arm { border-radius: 2dp; }
.follow { width: 10dp; height: 10dp; border-radius: 5dp; }
.lab .lf { position: absolute; left: 6dp; right: 6dp; bottom: 3dp; height: 3dp; border-radius: 2dp; }
.lab .lfi { position: absolute; left: 0dp; top: 0dp; height: 3dp; border-radius: 2dp; }
/* a row is 40 dp tall (a two-line row: 36 + 4 padding); its controls sit at the right edge, placed absolutely so a
 * second line of text never pushes them down */
.srow { position: relative; display: block; height: 40dp; line-height: 40dp; padding: 0dp 8dp; border-radius: 8dp;
        font-size: 13.5dp; font-weight: bold; cursor: pointer; white-space: nowrap; }
.srow.two { line-height: 17dp; padding-top: 4dp; height: 36dp; }
.srow .sm { display: block; font-size: 11dp; font-weight: normal; }
.srow .v { position: absolute; right: 8dp; top: 0dp; line-height: 40dp; font-weight: bold; width: 40dp; text-align: right; }
.srow .lock { position: absolute; right: 52dp; top: 0dp; line-height: 40dp; font-size: 11dp; }
.srow .chip { position: absolute; right: 8dp; top: 7dp; height: 26dp; line-height: 24dp; padding: 0dp 10dp;
              border-radius: 7dp; border-width: 1dp; font-size: 12dp; }
.track { position: absolute; right: 56dp; top: 18dp; width: 104dp; height: 4dp; border-radius: 2dp; }
.fill { position: absolute; left: 0dp; top: 0dp; height: 4dp; border-radius: 2dp; }
/* the thumb: a smooth circle picture (icons/tog-knob.svg, 2026-11-23), tinted below */
.thumb { position: absolute; top: -7dp; width: 18dp; height: 18dp; margin-left: -9dp; }
.thumb .tk { position: absolute; left: 0dp; top: 0dp; width: 18dp; height: 18dp; }
.tick { position: absolute; top: -5dp; width: 2dp; height: 14dp; margin-left: -1dp; }
/* one cursor while a slider is dragged, wherever the mouse goes (snatcherLeo: "It should stay as 1 cursor") */
.track, .thumb, .fill { cursor: pointer; }
body.dragging, body.dragging * { cursor: pointer; }
.tog { position: absolute; right: 8dp; top: 9dp; width: 38dp; height: 22dp; border-radius: 11dp; }
.knob { position: absolute; top: 3dp; left: 3dp; width: 16dp; height: 16dp; border-radius: 8dp; }
.tog.on .knob { left: 19dp; }
.btn { display: block; height: 34dp; line-height: 32dp; margin-top: 6dp; text-align: center; border-radius: 9dp;
       border-width: 1dp; font-size: 13dp; font-weight: bold; cursor: pointer; }
/* the GameCube-accurate note under the stick columns: the columns' full width, lined up with their outer edges, a gap
 * above so it doesn't touch them (snatcherLeo, 2026-11-13: it sat indented and narrower than the columns) */
.acc { display: block; margin: 8dp 0dp 4dp 0dp; padding: 7dp 12dp; border-radius: 7dp; border-left-width: 2dp;
       font-size: 11.5dp; line-height: 16dp; }
.warn { display: block; font-size: 12dp; margin: 2dp 8dp 4dp 8dp; }
/* calibrating */
.callout { display: block; margin: 8dp 0dp; padding: 12dp 14dp; border-radius: 10dp; border-width: 1dp; font-size: 13dp;
           line-height: 18dp; }
.callout .q { display: block; font-size: 14dp; font-weight: bold; margin-bottom: 4dp; }
.prog { display: block; height: 5dp; margin: 10dp 0dp 2dp 0dp; }
.prog .p { display: inline-block; width: 31%; height: 5dp; margin-right: 2%; border-radius: 3dp; }
.two-btn .btn { display: inline-block; width: 46%; margin-right: 3%; }

/* ---- the bottom bar: the buttons that work here, then Reset and Save ---- */
#bot { position: absolute; left: 0dp; right: 0dp; bottom: 0dp; height: 56dp; line-height: 56dp; padding: 0dp 20dp 0dp 24dp;
       border-top-width: 1dp; font-size: 12.5dp; }
.hi { display: inline-block; margin-right: 16dp; }
/* the hints stop before Reset and Save (a longer language is cut at the edge rather than running under the buttons) */
#bot .hl { position: absolute; left: 24dp; right: 400dp; top: 0dp; height: 56dp; overflow: hidden; white-space: nowrap; }
.k { display: inline-block; min-width: 20dp; height: 20dp; line-height: 20dp; padding: 0dp 5dp; border-radius: 10dp;
     font-size: 10dp; font-weight: bold; text-align: center; color: #FFFFFF; margin-right: 6dp; vertical-align: middle; }
.k.sq { border-radius: 5dp; }
#bot .rt { position: absolute; right: 20dp; top: 10dp; height: 36dp; }
/* the buttons' own line height, not the bar's 56: inherited, it set them on a 56-high line, which pushed them about
 * 9dp down to the window's bottom edge (snatcherLeo, 2026-11-23: "make they move up vertically a little") */
#bot .rt { white-space: nowrap; line-height: 36dp; }
#bot .rt .btn { vertical-align: top; }
/* sized to their words, at least as wide as the English ones */
#bot .rt .btn { display: inline-block; width: auto; min-width: 170dp; padding: 0dp 14dp; box-sizing: border-box; height: 36dp;
                line-height: 34dp; margin: 0dp 0dp 0dp 10dp; }

/* ---- the device list (drop-down) and the save question ---- */
/* under the device picker: the profile picker (240) and the gap (10) to its right, the same width as the picker */
#list { display: none; position: absolute; right: 270dp; top: 52dp; width: 270dp; box-sizing: border-box; padding: 6dp;
        border-radius: 10dp; border-width: 1dp; }
#list .opt, #plist .opt { white-space: nowrap; overflow: hidden; }
body.listing #list { display: block; }
/* the profile list (mockup 43): under the Profile picker */
#plist { display: none; position: absolute; right: 20dp; top: 52dp; width: 240dp; box-sizing: border-box; padding: 6dp;
         border-radius: 10dp; border-width: 1dp; }
body.plisting #plist { display: block; }
#plist .lh { display: block; font-size: 10dp; letter-spacing: 2dp; font-weight: bold; padding: 6dp 8dp 4dp 8dp; }
#plist .ck { display: inline-block; width: 18dp; font-weight: bold; }
#plist .tag { float: right; font-size: 10.5dp; }
#plist .act { padding-left: 30dp; font-size: 12.5dp; }
#plist .act.f { padding-left: 27dp; }
.psep { display: block; height: 1dp; margin: 5dp 4dp; }
#prompt .pbtns { display: block; margin-top: 4dp; }
#prompt .pbtns .btn { display: inline-block; margin-right: 2%; }
#prompt .pbtns.n2 .btn { width: 47%; }
#prompt .pbtns.n3 .btn { width: 31%; }
#pname { display: block; width: 100%; box-sizing: border-box; height: 36dp; line-height: 32dp; padding: 0dp 10dp;
         border-radius: 8dp; border-width: 2dp; font-size: 15dp; margin-bottom: 8dp; cursor: text; }
.perr { display: block; font-size: 12dp; margin-bottom: 6dp; }
.opt { display: block; padding: 9dp 12dp; border-radius: 7dp; font-size: 13dp; cursor: pointer; }
.opt.f { border-left-width: 3dp; padding-left: 9dp; }
#prompt { display: none; position: absolute; left: 50%; top: 50%; width: 420dp; margin-left: -210dp; margin-top: -110dp;
          padding: 20dp 22dp; border-radius: 14dp; border-width: 1dp; }
body.asking #prompt { display: block; }
#prompt .q { display: block; font-family: "Saira"; font-size: 19dp; font-weight: bold; margin-bottom: 6dp; }
#prompt .t { display: block; font-size: 13dp; margin-bottom: 14dp; }

/* ---- dark ---- */
body.dark { background-color: #0F1211; color: #E9EDEA; }
body.dark #top, body.dark #bot, body.dark #side { border-color: #1F2421; }
body.dark #sub, body.dark .h, body.dark #bot, body.dark .warn, body.dark .gnum, body.dark .srow .sm,
body.dark .tpc { color: #8A938E; }
body.dark .gnum b { color: #E9EDEA; }
body.dark #back { border-color: #3A423E; color: #B4BCB7; }
body.dark .dsel, body.dark .lab, body.dark .grp, body.dark .btn, body.dark .srow .chip
  { background-color: #1B1F1D; border-color: #2C322F; color: #E9EDEA; }
body.dark .scol { border-color: #2C322F; background-color: rgba(255, 255, 255, 4); }
body.dark .dchip { background-color: #1B1F1D; border-color: #2C322F; color: #E9EDEA; }
body.dark .drow.f .dchip, body.dark .crow.f { background-color: rgba(232, 149, 90, 36); }
body.dark .drow.f .dchip { border-color: #E8955A; }
body.dark .drow.push .dchip { background-color: #3A2A1E; border-color: #E8955A; }
body.dark .drow.listen .dchip { border-color: #E8955A; color: #E8955A; background-color: rgba(232, 149, 90, 36); }
body.dark .csep { background-color: #2C322F; } body.dark .crow .lock { color: #E8955A; }
body.dark .gate { border-color: #2C322F; }
body.dark .gate.on { border-color: #4A524E; background-color: rgba(255, 255, 255, 6); }
body.dark .gates.f .gate.on { border-color: #E8955A; background-color: rgba(232, 149, 90, 18); }
body.dark .rd { background-color: #6F7A73; }
body.dark .tbar { background-color: #2C322F; } body.dark .tfill { background-color: #8FA98A; }
body.dark .tclick { background-color: #E8955A; }
body.dark .tdig { border-color: #4A524E; } body.dark .tdig.on { background-color: #E8955A; border-color: #E8955A; }
body.dark .pulse { border-color: #E8955A; }
body.dark .follow { background-color: #E8955A; }
body.dark .lab.flash { border-color: #E8955A; background-color: #3A2A1E; }
body.dark .lab .lf { background-color: #2C322F; } body.dark .lab .lfi { background-color: #8FA98A; }
body.dark .grp .gh { border-color: #2C322F; }
body.dark .lab .on, body.dark .dr .on, body.dark .dr .ar, body.dark .dsel .c { color: #B4BCB7; }
body.dark .lab.f, body.dark .srow.f, body.dark .btn.f, body.dark .dsel.f, body.dark .grp.f
  { border-color: #E8955A; }
body.dark .lab.f, body.dark .srow.f, body.dark .btn.f, body.dark .dsel.f, body.dark .dr.f
  { background-color: rgba(232, 149, 90, 36); }
body.dark .dr.f { border-color: #E8955A; }
body.dark .lab.listen, body.dark .dr.listen, body.dark .srow.listen .chip { border-color: #E8955A; color: #E8955A; }
body.dark .btn.pri { background-color: #E8955A; border-color: #E8955A; color: #1A120C; }
body.dark .lit, body.dark .litdot { background-color: #E8955A; }
body.dark .ring.lit { border-color: #8FA98A; }
body.dark .dzc { background-color: rgba(232, 149, 90, 70); }
body.dark .rawc { border-color: #8A938E; }
body.dark .sentc { background-color: #E9EDEA; }
body.dark #sent-1 { background-color: #F2C318; }
body.dark .cd { background-color: #E8955A; }
body.dark .track { background-color: #3A423E; }
body.dark .fill { background-color: #8FA98A; }
body.dark .thumb .tk { image-color: #C3D8BD; }
body.dark .tick { background-color: #E8955A; }
body.dark .tog { background-color: #3A423E; } body.dark .tog .knob { background-color: #B4BCB7; }
body.dark .tog.on { background-color: #8FA98A; } body.dark .tog.on .knob { background-color: #13200F; }
body.dark .srow .lock { color: #E8955A; }
body.dark .acc { color: #B4BCB7; background-color: rgba(232, 149, 90, 23); border-color: #E8955A; }
body.dark .callout { background-color: rgba(232, 149, 90, 26); border-color: #E8955A; }
body.dark .prog .p { background-color: #2C322F; } body.dark .prog .p.on { background-color: #E8955A; }
body.dark #note { color: #8A938E; } body.dark #note.ok { color: #7FC08A; }
body.dark #list, body.dark #prompt, body.dark #plist { background-color: #1B1F1D; border-color: #3A423E; }
body.dark #plist .lh, body.dark #plist .tag { color: #8A938E; } body.dark #plist .ck { color: #E8955A; }
body.dark .psep { background-color: #2C322F; }
body.dark #pname { background-color: #0F1211; border-color: #E8955A; color: #E9EDEA; }
body.dark .perr { color: #E8955A; }
body.dark .opt.f { background-color: #2C322F; border-color: #E8955A; }
body.dark .k.sq { background-color: #3A423E; color: #E9EDEA; }

/* ---- light ---- */
body.light { background-color: #F2F4F1; color: #18201B; }
body.light #top, body.light #bot, body.light #side { border-color: #D5DCD4; }
body.light #sub, body.light .h, body.light #bot, body.light .warn, body.light .gnum, body.light .srow .sm,
body.light .tpc { color: #66726B; }
body.light .gnum b { color: #18201B; }
body.light #back { border-color: #B8C2B6; color: #45514A; }
body.light .dsel, body.light .lab, body.light .grp, body.light .btn, body.light .srow .chip
  { background-color: #FFFFFF; border-color: #D5DCD4; color: #18201B; }
body.light .scol { border-color: #D5DCD4; background-color: #FFFFFF; }
body.light .dchip { background-color: #FFFFFF; border-color: #D5DCD4; color: #18201B; }
body.light .drow.f .dchip, body.light .crow.f { background-color: rgba(194, 82, 47, 22); }
body.light .drow.f .dchip { border-color: #C2522F; }
body.light .drow.push .dchip { background-color: #F6E3DA; border-color: #C2522F; }
body.light .drow.listen .dchip { border-color: #C2522F; color: #C2522F; background-color: #FFF7F2; }
body.light .csep { background-color: #E3E8E1; } body.light .crow .lock { color: #C2522F; }
body.light .gate { border-color: #D5DCD4; background-color: #FFFFFF; }
body.light .gate.on { border-color: #9AA59C; }
body.light .gates.f .gate.on { border-color: #C2522F; background-color: #FBF1EC; }
body.light .rd { background-color: #8A958D; }
body.light .tbar { background-color: #E3E8E1; } body.light .tfill { background-color: #5D7A57; }
body.light .tclick { background-color: #C2522F; }
body.light .tdig { border-color: #B8C2B6; } body.light .tdig.on { background-color: #C2522F; border-color: #C2522F; }
body.light .pulse { border-color: #C2522F; }
body.light .follow { background-color: #C2522F; }
body.light .lab.flash { border-color: #C2522F; background-color: #F8EAE4; }
body.light .lab .lf { background-color: #E3E8E1; } body.light .lab .lfi { background-color: #5D7A57; }
body.light .grp .gh { border-color: #E3E8E1; }
body.light .lab .on, body.light .dr .on, body.light .dr .ar, body.light .dsel .c { color: #45514A; }
body.light .lab.f, body.light .srow.f, body.light .btn.f, body.light .dsel.f, body.light .grp.f
  { border-color: #C2522F; }
body.light .lab.f, body.light .srow.f, body.light .btn.f, body.light .dsel.f, body.light .dr.f
  { background-color: rgba(194, 82, 47, 22); }
body.light .dr.f { border-color: #C2522F; }
body.light .lab.listen, body.light .dr.listen, body.light .srow.listen .chip { border-color: #C2522F; color: #C2522F; }
body.light .btn.pri { background-color: #C2522F; border-color: #C2522F; color: #FFFFFF; }
body.light .lit, body.light .litdot { background-color: #C2522F; }
body.light .ring.lit { border-color: #5D7A57; }
body.light .dzc { background-color: rgba(194, 82, 47, 60); }
body.light .rawc { border-color: #66726B; }
body.light .sentc { background-color: #18201B; }
body.light #sent-1 { background-color: #C9A21A; }
body.light .cd { background-color: #C2522F; }
body.light .track { background-color: #D5DCD4; }
body.light .fill { background-color: #5D7A57; }
body.light .thumb .tk { image-color: #4C6847; }
body.light .tick { background-color: #C2522F; }
body.light .tog { background-color: #C9D1C7; } body.light .tog .knob { background-color: #FFFFFF; }
body.light .tog.on { background-color: #5D7A57; } body.light .tog.on .knob { background-color: #FFFFFF; }
body.light .srow .lock { color: #C2522F; }
body.light .acc { color: #45514A; background-color: rgba(194, 82, 47, 18); border-color: #C2522F; }
body.light .callout { background-color: rgba(194, 82, 47, 16); border-color: #C2522F; }
body.light .prog .p { background-color: #D5DCD4; } body.light .prog .p.on { background-color: #C2522F; }
body.light #note { color: #66726B; } body.light #note.ok { color: #2E7D3A; }
body.light #list, body.light #prompt, body.light #plist { background-color: #FFFFFF; border-color: #B8C2B6; }
body.light #plist .lh, body.light #plist .tag { color: #66726B; } body.light #plist .ck { color: #C2522F; }
body.light .psep { background-color: #E3E8E1; }
body.light #pname { background-color: #FFFFFF; border-color: #C2522F; color: #18201B; }
body.light .perr { color: #C2522F; }
body.light .opt.f { background-color: #E6ECE4; border-color: #C2522F; }
body.light .k.sq { background-color: #B8C2B6; color: #18201B; }

/* the mouse over anything that can be clicked on the controller screen (snatcherLeo, 2026-11-13: the buttons to change, the
 * back arrow, the device and profile pickers and the side panel, "ensure these are hoverable", "all on the controller
 * page"): the same quiet lift as the Settings menus (settings.rcss), a lighter fill and edge; greyed rows (.off) get
 * none; last in the file so the controller's orange focus (.f) and a waiting row (.listen) keep their look */
body.dark #back:hover { background-color: #232826; border-color: #C9DCC4; color: #E9EDEA; }
body.light #back:hover { background-color: #E9EEE7; border-color: #5D7A57; color: #18201B; }
body.dark .dsel:hover, body.dark .lab:hover, body.dark .btn:hover, body.dark .srow .chip:hover,
body.dark .drow:hover .dchip { background-color: #252B28; border-color: #5A645F; }
body.light .dsel:hover, body.light .lab:hover, body.light .btn:hover, body.light .srow .chip:hover,
body.light .drow:hover .dchip { background-color: #EEF2EC; border-color: #B8C2B6; }
body.dark .dr:hover, body.dark .opt:hover { background-color: rgba(255, 255, 255, 12); }
body.light .dr:hover, body.light .opt:hover { background-color: rgba(24, 32, 27, 9); }
body.dark .srow:hover, body.dark .crow:hover { background-color: rgba(255, 255, 255, 8); }
body.light .srow:hover, body.light .crow:hover { background-color: rgba(24, 32, 27, 7); }
body.dark .btn.pri:hover { background-color: #F2A774; border-color: #F2A774; }
body.light .btn.pri:hover { background-color: #A8421F; border-color: #A8421F; }
/* greyed: no lift */
body.dark .off:hover, body.light .off:hover, body.dark .dsel.off:hover, body.light .dsel.off:hover,
body.dark .drow.off:hover .dchip, body.light .drow.off:hover .dchip { background-color: transparent; }
body.dark .dsel.off:hover, body.dark .btn.off:hover, body.dark .drow.off:hover .dchip { background-color: #1B1F1D; border-color: #2C322F; }
body.light .dsel.off:hover, body.light .btn.off:hover, body.light .drow.off:hover .dchip { background-color: #FFFFFF; border-color: #D5DCD4; }
/* the controller's focus and a row waiting for a press keep their own look under the mouse */
body.dark .lab.f:hover, body.dark .srow.f:hover, body.dark .btn.f:hover, body.dark .dsel.f:hover, body.dark .dr.f:hover,
body.dark .crow.f:hover, body.dark .drow.f:hover .dchip { background-color: rgba(232, 149, 90, 36); border-color: #E8955A; }
body.light .lab.f:hover, body.light .srow.f:hover, body.light .btn.f:hover, body.light .dsel.f:hover, body.light .dr.f:hover,
body.light .crow.f:hover, body.light .drow.f:hover .dchip { background-color: rgba(194, 82, 47, 22); border-color: #C2522F; }
body.dark .drow.listen:hover .dchip { background-color: rgba(232, 149, 90, 36); border-color: #E8955A; }
body.light .drow.listen:hover .dchip { background-color: rgba(194, 82, 47, 22); border-color: #C2522F; }
body.dark .opt.f:hover { background-color: #2C322F; } body.light .opt.f:hover { background-color: #E6ECE4; }
